# TEAM GITTER 필독
# 이 파일의 내용을 프로젝트 최상위의 .env로 복사하여 필요한 설정만 수정해서 사용한다.
# 현재 파일은 절대 수정하지 않는다.

# Flask 세션 서명용 비밀키: 환경마다 별도로 생성하고 DB 비밀번호와 다른 값 사용
SECRET_KEY=CHANGE_SESSION_SECRET

# PostgreSQL 접속 비밀번호: DB 계정 생성 시 정한 비밀번호로 변경
DB_PASSWORD=CHANGE_DB_PASSWORD

DATABASE_URL=postgresql+psycopg://moajup_user:${DB_PASSWORD}@localhost:5432/moajup
